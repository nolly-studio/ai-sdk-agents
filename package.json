{
  "name": "ai-sdk-agents",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:packages": "turbo build --filter=./packages/*",
    "dev": "turbo dev",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "verify:publish": "turbo verify:publish",
    "registry:build": "pnpm dlx shadcn@latest build --output apps/web/public/r",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && pnpm verify:publish && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "turbo": "^2.9.18",
    "typescript": "^5",
    "ultracite": "7.10.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9"
}
