{
  "name": "@aisdkagents/react",
  "version": "0.2.0",
  "description": "Headless React primitives for AI SDK agent UIs",
  "homepage": "https://github.com/nolly-studio/ai-sdk-agents#readme",
  "bugs": {
    "url": "https://github.com/nolly-studio/ai-sdk-agents/issues"
  },
  "license": "MIT",
  "author": {
    "name": "nolansym",
    "url": "https://twitter.com/nolansym"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nolly-studio/ai-sdk-agents",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./artifact-session": {
      "types": "./dist/artifact-session/index.d.ts",
      "default": "./dist/artifact-session/index.js"
    },
    "./data-stream-controller": {
      "types": "./dist/data-stream-controller/index.d.ts",
      "default": "./dist/data-stream-controller/index.js"
    },
    "./prompt-input": {
      "types": "./dist/prompt-input/index.d.ts",
      "default": "./dist/prompt-input/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && node ./scripts/ensure-use-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "verify:publish": "node ./scripts/verify-publish.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:publish"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ai": "^5.0.0",
    "iconv-lite": "0.7.3",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
